# ─── Google credentials ───────────────────────────────────────────────
# Leave unset to use Application Default Credentials from
# `gcloud auth application-default login` (run `ga4-seo-mcp auth-command`).
# Or point it at a service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Toolsets and write access ────────────────────────────────────────
# Comma-separated: admin,data,gsc,psi,dataforseo,ads  (default: admin,data,gsc,psi)
# GA4SEO_TOOLSETS=admin,data,gsc,psi
# Set to 1 to register create/update/delete/submit/verify tools. Off by default.
# GA4SEO_ENABLE_WRITES=0

# ─── PageSpeed Insights (optional, raises the anonymous quota) ────────
# PAGESPEED_API_KEY=

# ─── DataForSEO (toolset "dataforseo") ────────────────────────────────
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# ─── Google Ads Keyword Planner (toolset "ads", needs the [ads] extra) ─
# Or store the token in ~/.config/ga4-seo-mcp/dev-token with chmod 600.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ─── HTTP transport (only for --transport streamable-http / sse) ──────
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Require "Authorization: Bearer <token>" on every HTTP request:
# MCP_AUTH_TOKEN=
# Exact origins for a browser-based client. Never use "*".
# MCP_CORS_ORIGINS=http://localhost:3000
